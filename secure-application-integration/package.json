{
  "name": "secure-application-integration",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
